# Server
PORT=5000
FLASK_DEBUG=false
SESSION_SECRET=replace_with_a_long_random_string
SESSION_COOKIE_SECURE=false

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=expense_tracker
DB_SSL=false
# DB_SSL_CA=C:\path\to\ca.pem

# Admin account created by `python init_db.py`
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@spendly.local
ADMIN_PASSWORD=Admin@123

# Optional: add sample expenses when running init_db.py
SEED_DEMO_DATA=false

# Display settings
APP_NAME=Expense Tracker
CURRENCY_CODE=INR
CURRENCY_LOCALE=en-IN
